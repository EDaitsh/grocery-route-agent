# העתיקו לקובץ .env ומלאו ערכים. אין להעלות את .env ל-GitHub.

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# LangSmith - https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=grocery-route-agent

# מודלים (בדקו מזהים עדכניים ב-openrouter.ai/models)
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
JUDGE_MODEL=openai/gpt-4o-mini
REFERENCE_PAID_MODEL=openai/gpt-4o-mini
EVAL_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openai/gpt-4o-mini,google/gemini-2.5-flash-lite

# אופציונלי
AGENT_STORE=demo_store
# AGENT_MOCK=1          מצב הדגמה ללא רשת
# AGENT_BIDI=1          סידור עברית לתצוגה בטרמינל (ברירת מחדל: פעיל ב-Windows)
# AGENT_DEBUG=1         הצגת traceback מלא בשגיאות
